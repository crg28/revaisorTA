# Required. Free key (no credit card): https://aistudio.google.com/apikey
AI_API_KEY=

# Optional (defaults shown). Any OpenAI-compatible provider works.
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=20
# URL the *browser* uses to reach the backend (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
